# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── SQL Server ──────────────────────────────────────────────────────────────
DB_SA_PASSWORD=YourStrong@Passw0rd
DB_CONNECTION_STRING=Server=db;Database=TaskManagement;User=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-a-long-random-hex-string
JWT_ISSUER=TaskManagement
JWT_AUDIENCE=TaskManagementClient
JWT_EXPIRY_MINUTES=1440

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_API_URL=http://localhost:5034/api
